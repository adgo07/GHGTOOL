{
"$schema":"https://json-schema.org/draft/2020-12/schema",
"$id":"https://adgo07.github.io/GHGTOOL/business_rules.schema.json",
"title":"GHGTOOL review-only business rules candidate bundle",
"type":"object","additionalProperties":false,
"required":["schema_version","rule_set_id","kind","revision","base","dependency","status","groups","adopts","rules","policies","fields","operations","changes"],
"properties":{
"schema_version":{"const":"1.2"},"rule_set_id":{"$ref":"#/$defs/token"},
"kind":{"enum":["COMMON","INDUSTRY","SOFTWARE"]},"revision":{"$ref":"#/$defs/fixedRevision"},
"base":{"$ref":"#/$defs/nonBlank"},"dependency":{"type":"array","items":{"$ref":"#/$defs/dependency"}},
"status":{"const":"CANDIDATE"},"groups":{"type":"array","items":{"$ref":"#/$defs/group"}},
"adopts":{"type":"array","items":{"$ref":"#/$defs/adopt"}},"rules":{"type":"array","items":{"$ref":"#/$defs/rule"}},
"policies":{"type":"array","items":{"$ref":"#/$defs/policy"}},"fields":{"type":"array","items":{"$ref":"#/$defs/field"}},
"operations":{"type":"array","items":{"$ref":"#/$defs/operation"}},"changes":{"type":"array","items":{"$ref":"#/$defs/change"}}
},
"$defs":{
"nonBlank":{"type":"string","minLength":1,"pattern":"\\S"},
"token":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
"fixedRevision":{"allOf":[{"$ref":"#/$defs/token"}],"not":{"pattern":"^[lL][aA][tT][eE][sS][tT]$"}},
"strings":{"type":"array","items":{"$ref":"#/$defs/nonBlank"},"uniqueItems":true},
"tokens":{"type":"array","items":{"$ref":"#/$defs/token"},"uniqueItems":true},
"nonEmptyTokens":{"allOf":[{"$ref":"#/$defs/tokens"}],"minItems":1},
"dependency":{"type":"object","additionalProperties":false,"required":["rule_set_id","revision"],"properties":{"rule_set_id":{"$ref":"#/$defs/token"},"revision":{"$ref":"#/$defs/fixedRevision"}}},
"group":{"type":"object","additionalProperties":false,"required":["id","rule_ids"],"properties":{"id":{"$ref":"#/$defs/token"},"rule_ids":{"$ref":"#/$defs/nonEmptyTokens"}}},
"adopt":{"type":"object","additionalProperties":false,"required":["rule_set_id","revision","group_ids","rule_ids"],"properties":{"rule_set_id":{"$ref":"#/$defs/token"},"revision":{"$ref":"#/$defs/fixedRevision"},"group_ids":{"$ref":"#/$defs/tokens"},"rule_ids":{"$ref":"#/$defs/nonEmptyTokens"}}},
"nullableToken":{"oneOf":[{"$ref":"#/$defs/token"},{"type":"null"}]},
"nullableText":{"oneOf":[{"$ref":"#/$defs/nonBlank"},{"type":"null"}]},
"stringMap":{"type":"object","additionalProperties":{"$ref":"#/$defs/nonBlank"}},
"applicability":{
"type":"object","additionalProperties":false,
"required":["scope","standard_ids","regions","industries","subject_ids","parameter_types","emission_source_types","greenhouse_gases","period_from","period_to","conditions","reason"],
"properties":{
"scope":{"enum":["ALL_ADOPTED","FILTERED","NOT_APPLICABLE"]},"standard_ids":{"$ref":"#/$defs/tokens"},
"regions":{"$ref":"#/$defs/strings"},"industries":{"$ref":"#/$defs/strings"},"subject_ids":{"$ref":"#/$defs/tokens"},
"parameter_types":{"$ref":"#/$defs/tokens"},"emission_source_types":{"$ref":"#/$defs/tokens"},"greenhouse_gases":{"$ref":"#/$defs/tokens"},
"period_from":{"oneOf":[{"type":"string","format":"date"},{"type":"null"}]},
"period_to":{"oneOf":[{"type":"string","format":"date"},{"type":"null"}]},
"conditions":{"$ref":"#/$defs/stringMap"},"reason":{"oneOf":[{"$ref":"#/$defs/nonBlank"},{"type":"null"}]}
}},
"rule":{
"type":"object","additionalProperties":false,
"required":["rule_id","rule_domain","relation","description","standard_id","target_id","applicability","priority","origin","evidence_status","supersedes_rule_ids","conflict_resolved","resolution_reason","parameter_id","selection_policy","required_factor_id","required_factor_version","payload","applies_to_parameter_ids","required_factor_ids","source_location","evidence_source_id","confirmation_id"],
"properties":{
"rule_id":{"$ref":"#/$defs/token"},"rule_domain":{"$ref":"#/$defs/token"},
"relation":{"enum":["BASE","SPECIALIZE","OVERRIDE","EXTEND","SUPPLEMENT","CONFLICT_REVIEW"]},
"description":{"$ref":"#/$defs/nonBlank"},"standard_id":{"$ref":"#/$defs/nullableToken"},"target_id":{"$ref":"#/$defs/nullableToken"},
"applicability":{"$ref":"#/$defs/applicability"},"priority":{"type":"integer"},
"origin":{"enum":["STANDARD_EXPLICIT","SOFTWARE_DERIVED","CONFIRMED_CORRECTION"]},
"evidence_status":{"enum":["VERIFIED","PENDING","CONFLICT"]},"supersedes_rule_ids":{"$ref":"#/$defs/tokens"},
"conflict_resolved":{"type":"boolean"},"resolution_reason":{"$ref":"#/$defs/nullableText"},
"parameter_id":{"$ref":"#/$defs/nullableToken"},"selection_policy":{"oneOf":[{"enum":["STANDARD_REQUIRED","MEASURED_FIRST","OFFICIAL_LATEST","SYSTEM_GWP","NO_AUTOMATIC_SELECTION"]},{"type":"null"}]},
"required_factor_id":{"$ref":"#/$defs/nullableToken"},"required_factor_version":{"$ref":"#/$defs/nullableToken"},
"payload":{"$ref":"#/$defs/stringMap"},"applies_to_parameter_ids":{"$ref":"#/$defs/tokens"},"required_factor_ids":{"$ref":"#/$defs/tokens"},
"source_location":{"$ref":"#/$defs/nullableText"},"evidence_source_id":{"$ref":"#/$defs/nullableToken"},"confirmation_id":{"$ref":"#/$defs/nullableToken"}
}},
"defaultState":{"oneOf":[
{"type":"object","additionalProperties":false,"required":["state"],"properties":{"state":{"const":"NONE"}}},
{"type":"object","additionalProperties":false,"required":["state","value"],"properties":{"state":{"const":"FIXED"},"value":{"type":["string","number","boolean"]}}},
{"type":"object","additionalProperties":false,"required":["state","parameter_id"],"properties":{"state":{"const":"BINDING"},"parameter_id":{"$ref":"#/$defs/token"}}},
{"type":"object","additionalProperties":false,"required":["state","policy_id"],"properties":{"state":{"const":"POLICY"},"policy_id":{"$ref":"#/$defs/token"}}},
{"type":"object","additionalProperties":false,"required":["state","reason"],"properties":{"state":{"const":"PENDING"},"reason":{"$ref":"#/$defs/nonBlank"}}}
]},
"numericValue":{"anyOf":[{"type":"number"},{"type":"string","pattern":"^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"}]},
"sourceState":{"oneOf":[
{"type":"object","additionalProperties":false,"required":["state","reason"],"properties":{"state":{"const":"NOT_APPLICABLE"},"reason":{"$ref":"#/$defs/nonBlank"}}},
{"type":"object","additionalProperties":false,"required":["state","reason"],"properties":{"state":{"const":"NO_LEGAL_SOURCES"},"reason":{"$ref":"#/$defs/nonBlank"}}},
{"type":"object","additionalProperties":false,"required":["state","values"],"properties":{"state":{"const":"FIXED"},"values":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["STANDARD_DEFAULT","CALCULATED","MEASURED"]}}}},
{"type":"object","additionalProperties":false,"required":["state","policy_id"],"properties":{"state":{"const":"POLICY"},"policy_id":{"$ref":"#/$defs/token"}}},
{"type":"object","additionalProperties":false,"required":["state","reason"],"properties":{"state":{"const":"PENDING"},"reason":{"$ref":"#/$defs/nonBlank"}}}
]},
"lockingProperty":{"type":"object","additionalProperties":false,"required":["state","reason"],"properties":{"state":{"enum":["EDITABLE","LOCKED","CONDITIONAL","NOT_APPLICABLE","PENDING"]},"reason":{"$ref":"#/$defs/nonBlank"}}},
"locking":{"type":"object","additionalProperties":false,"required":["value","source"],"properties":{"value":{"$ref":"#/$defs/lockingProperty"},"source":{"$ref":"#/$defs/lockingProperty"}}},
"range":{"type":"object","additionalProperties":false,"minProperties":2,"properties":{"min":{"type":"string","pattern":"^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"},"max":{"type":"string","pattern":"^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"},"include_min":{"type":"boolean"},"include_max":{"type":"boolean"}},"dependentRequired":{"min":["include_min"],"max":["include_max"]},"dependentSchemas":{"include_min":{"required":["min"]},"include_max":{"required":["max"]}}},
"when":{
"type":"object","additionalProperties":false,"required":["tags","ranges"],
"properties":{
"tags":{"type":"object","additionalProperties":false,"properties":{
"origin":{"enum":["CATALOG","CUSTOM","LEGACY_UNSPECIFIED"]},"binding_status":{"enum":["VERIFIED","ABSENT","PENDING"]},"parameter_id":{"$ref":"#/$defs/token"},"binding_id":{"$ref":"#/$defs/token"},
"component_mode":{"enum":["DIRECT","FCH"]},"source_path":{"enum":["CATALOGUE_TABLE_1","CATALOGUE_TABLE_2","CATALOGUE_TABLE_3","CATALOGUE_TABLE_4","CATALOGUE_TABLE_5","NONFOSSIL_ZERO","SUPPLY_UNIT_MEASURED","ENTERPRISE_MEASURED","ENTERPRISE_CALCULATED","ARBITRARY_OVERRIDE"]},
"direction":{"enum":["PURCHASED","EXPORTED"]},"attribute":{"enum":["CONVENTIONAL","NONFOSSIL","FOSSIL"]},"catalog_table":{"enum":["1","2","3","4","5"]},
"region":{"$ref":"#/$defs/nonBlank"},"province":{"$ref":"#/$defs/nonBlank"},"standard_id":{"$ref":"#/$defs/token"},
"period_type":{"enum":["ANNUAL","MONTHLY","CUSTOM"]},"fuel_path":{"enum":["MASS","VOLUME","HEAT"]}
}},
"ranges":{"type":"object","additionalProperties":false,"properties":{"carbonate_component_count":{"$ref":"#/$defs/range"}}}
},
"anyOf":[{"properties":{"tags":{"minProperties":1}}},{"properties":{"ranges":{"minProperties":1}}}]
},
"policyBranch":{"type":"object","additionalProperties":false,"required":["id","when","value"],"properties":{"id":{"$ref":"#/$defs/token"},"when":{"$ref":"#/$defs/when"},"value":{"anyOf":[{"$ref":"#/$defs/defaultState"},{"$ref":"#/$defs/sourceState"}]}}},
"policy":{"type":"object","additionalProperties":false,"required":["id","property","strategy","branches"],"properties":{"id":{"$ref":"#/$defs/token"},"property":{"enum":["default","source_qualification"]},"strategy":{"const":"UNIQUE_CONTEXT_MATCH"},"branches":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/policyBranch"}}}},
"projection":{"type":"object","additionalProperties":false,"required":["channel","label","unit","binding","notes"],"properties":{"channel":{"$ref":"#/$defs/token"},"label":{"$ref":"#/$defs/nonBlank"},"unit":{"$ref":"#/$defs/nonBlank"},"binding":{"$ref":"#/$defs/token"},"notes":{"$ref":"#/$defs/nonBlank"}}},
"field":{
"type":"object","additionalProperties":false,
"required":["id","name","kind","unit","source_qualification","default","locking","channel_projections","basis","consumers","cases","pending","rule_ids"],
"properties":{
"id":{"$ref":"#/$defs/token"},"name":{"$ref":"#/$defs/nonBlank"},
"kind":{"enum":["text","quantity","percentage","integer","enum","boolean","readonly_parameter","metadata","status","report"]},
"unit":{"$ref":"#/$defs/nonBlank"},"source_qualification":{"$ref":"#/$defs/sourceState"},"default":{"$ref":"#/$defs/defaultState"},"locking":{"$ref":"#/$defs/locking"},
"channel_projections":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/projection"}},
"basis":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/nonBlank"}},"consumers":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/nonBlank"}},
"cases":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/nonBlank"}},"pending":{"$ref":"#/$defs/strings"},"rule_ids":{"$ref":"#/$defs/tokens"}
},
"allOf":[
{"if":{"properties":{"kind":{"const":"boolean"}},"required":["kind"]},
 "then":{"properties":{"default":{"properties":{"value":{"type":"boolean"}}}}},
 "else":{"properties":{"default":{"properties":{"value":{"type":["string","number"]}}}}}},
{"if":{"properties":{"kind":{"enum":["quantity","percentage","integer","readonly_parameter"]}},"required":["kind"]},
 "then":{"properties":{"default":{"properties":{"value":{"$ref":"#/$defs/numericValue"}}}}}}
]
},
"operation":{
"type":"object","additionalProperties":false,
"required":["key","operation_id","name","initial_context","action","changes","preserves","invalidates","confirmation","basis","cases","pending","rule_ids"],
"properties":{
"key":{"$ref":"#/$defs/token"},"operation_id":{"$ref":"#/$defs/token"},"name":{"$ref":"#/$defs/nonBlank"},
"initial_context":{"$ref":"#/$defs/stringMap"},"action":{"$ref":"#/$defs/nonBlank"},"changes":{"$ref":"#/$defs/strings"},
"preserves":{"$ref":"#/$defs/strings"},"invalidates":{"$ref":"#/$defs/strings"},"confirmation":{"$ref":"#/$defs/strings"},
"basis":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/nonBlank"}},"cases":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/nonBlank"}},
"pending":{"$ref":"#/$defs/strings"},"rule_ids":{"$ref":"#/$defs/tokens"}
}},
"change":{
"type":"object","additionalProperties":false,"required":["key","change_type","before","after","reason","basis","pending"],
"properties":{"key":{"$ref":"#/$defs/token"},"change_type":{"$ref":"#/$defs/token"},"before":{"$ref":"#/$defs/nonBlank"},"after":{"$ref":"#/$defs/nonBlank"},
"reason":{"$ref":"#/$defs/nonBlank"},"basis":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/nonBlank"}},"pending":{"$ref":"#/$defs/strings"}}
}
}
}
